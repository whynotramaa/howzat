# ── Core ─────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000
WEB_BASE_URL=http://localhost:5173          # CORS origin + socket origin

# ── Postgres ─────────────────────────────────────────────────────────
# Neon: copy the *pooled* connection string from the dashboard.
#   postgresql://<user>:<pass>@<host>-pooler.<region>.aws.neon.tech/<db>?sslmode=require
# Prisma migrations cannot run through the pooler — DIRECT_URL is the
# non-pooled endpoint (same host without "-pooler").
# Note: a cold Neon compute can time out the first connection. Retry once.
DATABASE_URL=
DIRECT_URL=

# ── Redis ────────────────────────────────────────────────────────────
# Upstash: use the TLS URL from the dashboard — "rediss://", not "redis://".
#   rediss://default:<password>@<host>.upstash.io:6379
# Upstash REQUIRES TLS. With plain "redis://" the TCP connection is accepted
# and then dies, which surfaces as MaxRetriesPerRequestError rather than as a
# connection refusal — a confusing failure worth getting right the first time.
REDIS_URL=

# ── Auth ─────────────────────────────────────────────────────────────
# Generate each with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ── OTP email (Resend) ───────────────────────────────────────────────
# Get a key at https://resend.com/api-keys
# Leave RESEND_API_KEY blank in dev — the OTP is printed to the server log.
# With a key set but no verified domain, only your own Resend account address
# can receive mail; use onboarding@resend.dev as the sender until you verify one.
RESEND_API_KEY=
OTP_FROM_EMAIL=onboarding@resend.dev
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5

# ── Rate limiting ────────────────────────────────────────────────────
OTP_REQUESTS_PER_HOUR=5
BALL_WRITES_PER_MINUTE=120

# ── Frontend (Vite — must be VITE_ prefixed to reach the browser) ─────
VITE_API_BASE_URL=http://localhost:4000
VITE_SOCKET_URL=http://localhost:4000
