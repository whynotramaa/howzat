{
  "name": "howzat",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev --workspace @howzat/api",
    "dev:web": "npm run dev --workspace @howzat/web",
    "build": "npm run build --workspace @howzat/api && npm run build --workspace @howzat/web",
    "typecheck": "tsc -b --pretty",
    "lint": "eslint .",
    "test": "npm run test --workspace @howzat/shared",
    "format": "prettier --write .",
    "db:generate": "npm run db:generate --workspace @howzat/api",
    "db:migrate": "npm run db:migrate --workspace @howzat/api",
    "db:push": "npm run db:push --workspace @howzat/api",
    "db:studio": "npm run db:studio --workspace @howzat/api",
    "db:seed": "npm run db:seed --workspace @howzat/api"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "concurrently": "^9.1.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0"
  }
}
