{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npx prisma generate --schema apps/api/prisma/schema.prisma && npm run build --workspace @howzat/api && npm run build --workspace @howzat/web",
  "outputDirectory": "apps/web/dist",
  "functions": {
    "api/server.ts": {
      "includeFiles": "apps/api/{prisma,dist}/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/server"
    },
    {
      "source": "/live/(.*)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(WhatsApp|facebookexternalhit|Facebot|Twitterbot|TelegramBot|Slackbot|Discordbot|LinkedInBot|Pinterest|redditbot|SkypeUriPreview).*"
        }
      ],
      "destination": "/api/server"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
